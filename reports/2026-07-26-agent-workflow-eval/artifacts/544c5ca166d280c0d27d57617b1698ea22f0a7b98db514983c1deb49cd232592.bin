{'review': '<<<ARTIFACT review_report>>>\n{\n  "overall_status": "NEEDS_FIXES",\n  "quality_score": 5.5,\n  "summary": {\n    "critical": 0,\n    "high": 1,\n    "medium": 2,\n    "low": 0,\n    "passed_checks": [\n      "Type annotations",\n      "useCallback for returned functions",\n      "No hardcoded secrets",\n      "Input validation via TypeScript types"\n    ]\n  },\n  "findings": [\n    {\n      "finding_id": "F-001",\n      "severity": "high",\n      "category": "quality",\n      "title": "Shared loading and error state causes state conflicts",\n      "file": "src/hooks/useTodos.ts",\n      "line_range": [11, 84],\n      "description": "The hook uses a single loading state and single error state for all operations (list fetching, single todo fetching, and mutations). This can cause state conflicts: for example, fetching a single todo while the list is loading will overwrite the list loading state, leading to incorrect UI states where the list appears idle when it\'s actually loading.",\n      "impact": "Incorrect loading/error states in UI, poor user experience, and potential race conditions where state from one operation overwrites another.",\n      "suggested_fix": "Separate loading and error states for different operation types: list operations (fetchTodos), single todo operations (getTodo), and mutations (addTodo, updateTodo, removeTodo).",\n      "code_before": "  const [todos, setTodos] = useState<Todo[]>([]);\\n  const [loading, setLoading] = useState<boolean>(true);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const fetchTodos = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      let completedFilter: boolean | undefined;\\n      if (filter === \'active\') {\\n        completedFilter = false;\\n      } else if (filter === \'completed\') {\\n        completedFilter = true;\\n      }\\n      const data = await getTodos(completedFilter);\\n      setTodos(data);\\n    } catch (err: any) {\\n      setError(err.message);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [filter]);\\n\\n  const getTodo = useCallback(async (id: string) => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const todo = await getTodoById(id);\\n      return todo;\\n    } catch (err: any) {\\n      setError(err.message);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  const addTodo = useCallback(async (payload: CreateTodoPayload) => {\\n    try {\\n      const newTodo = await createTodo(payload);\\n      setTodos((prev) => [...prev, newTodo]);\\n      return newTodo;\\n    } catch (err: any) {\\n      setError(err.message);\\n      throw err;\\n    }\\n  }, []);\\n\\n  const updateExistingTodo = useCallback(async (id: string, payload: UpdateTodoPayload) => {\\n    try {\\n      const updatedTodo = await updateTodo(id, payload);\\n      setTodos((prev) => prev.map((todo) => (todo.id === id ? updatedTodo : todo)));\\n      return updatedTodo;\\n    } catch (err: any) {\\n      setError(err.message);\\n      throw err;\\n    }\\n  }, []);\\n\\n  const removeTodo = useCallback(async (id: string) => {\\n    try {\\n      await deleteTodo(id);\\n      setTodos((prev) => prev.filter((todo) => todo.id !== id));\\n    } catch (err: any) {\\n      setError(err.message);\\n      throw err;\\n    }\\n  }, []);",\n      "code_after": "  const [todos, setTodos] = useState<Todo[]>([]);\\n  const [listLoading, setListLoading] = useState<boolean>(false);\\n  const [listError, setListError] = useState<string | null>(null);\\n  const [detailLoading, setDetailLoading] = useState<boolean>(false);\\n  const [detailError, setDetailError] = useState<string | null>(null);\\n  const [mutationLoading, setMutationLoading] = useState<boolean>(false);\\n  const [mutationError, setMutationError] = useState<string | null>(null);\\n\\n  const fetchTodos = useCallback(async () => {\\n    setListLoading(true);\\n    setListError(null);\\n    try {\\n      let completedFilter: boolean | undefined;\\n      if (filter === \'active\') {\\n        completedFilter = false;\\n      } else if (filter === \'completed\') {\\n        completedFilter = true;\\n      }\\n      const data = await getTodos(completedFilter);\\n      setTodos(data);\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : String(err);\\n      setListError(message);\\n    } finally {\\n      setListLoading(false);\\n    }\\n  }, [filter]);\\n\\n  const getTodo = useCallback(async (id: string) => {\\n    setDetailLoading(true);\\n    setDetailError(null);\\n    try {\\n      const todo = await getTodoById(id);\\n      return todo;\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : String(err);\\n      setDetailError(message);\\n    } finally {\\n      setDetailLoading(false);\\n    }\\n  }, []);\\n\\n  const addTodo = useCallback(async (payload: CreateTodoPayload) => {\\n    setMutationLoading(true);\\n    setMutationError(null);\\n    try {\\n      const newTodo = await createTodo(payload);\\n      setTodos((prev) => [...prev, newTodo]);\\n      return newTodo;\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : String(err);\\n      setMutationError(message);\\n    } finally {\\n      setMutationLoading(false);\\n    }\\n  }, []);\\n\\n  const updateExistingTodo = useCallback(async (id: string, payload: UpdateTodoPayload) => {\\n    setMutationLoading(true);\\n    setMutationError(null);\\n    try {\\n      const updatedTodo = await updateTodo(id, payload);\\n      setTodos((prev) => prev.map((todo) => (todo.id === id ? updatedTodo : todo)));\\n      return updatedTodo;\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : String(err);\\n      setMutationError(message);\\n    } finally {\\n      setMutationLoading(false);\\n    }\\n  }, []);\\n\\n  const removeTodo = useCallback(async (id: string) => {\\n    setMutationLoading(true);\\n    setMutationError(null);\\n    try {\\n      await deleteTodo(id);\\n      setTodos((prev) => prev.filter((todo) => todo.id !== id));\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : String(err);\\n      setMutationError(message);\\n    } finally {\\n      setMutationLoading(false);\\n    }\\n  }, []);",\n      "references": []\n    },\n    {\n      "finding_id": "F-002",\n      "severity": "medium",\n      "category": "performance",\n      "title": "Todos list sorted on every render",\n      "file": "src/hooks/useTodos.ts",\n      "line_range": [86, 94],\n      "description": "The sortedTodos variable is computed on every render by creating a new array and sorting it. If the todos list is large, this causes unnecessary computation on each render.",\n      "impact": "Performance degradation with large todo lists due to repeated sorting operations.",\n      "suggested_fix": "Use useMemo to memoize the sorted list based on todos, sortBy, and sortOrder dependencies.",\n      "code_before": "  const sortedTodos = [...todos].sort((a, b) => {\\n    let compare = 0;\\n    if (sortBy === \'title\') {\\n      compare = a.title.localeCompare(b.title);\\n    } else if (sortBy === \'completed\') {\\n      compare = (a.completed === b.completed) ? 0 : a.completed ? 1 : -1;\\n    }\\n    return sortOrder === \'asc\' ? compare : -compare;\\n  });",\n      "code_after": "  const sortedTodos = useMemo(() => {\\n    return [...todos].sort((a, b) => {\\n      let compare = 0;\\n      if (sortBy === \'title\') {\\n        compare = a.title.localeCompare(b.title);\\n      } else if (sortBy === \'completed\') {\\n        compare = (a.completed === b.completed) ? 0 : a.completed ? 1 : -1;\\n      }\\n      return sortOrder === \'asc\' ? compare : -compare;\\n    });\\n  }, [todos, sortBy, sortOrder]);",\n      "references": []\n    },\n    {\n      "finding_id": "F-003",\n      "severity": "medium",\n      "category": "quality",\n      "title": "Error handling assumes Error object",\n      "file": "src/hooks/useTodos.ts",\n      "line_range": [29, 30],\n      "description": "Catch blocks assume the error value has a \'message\' property. If the thrown value is not an Error instance (e.g., a string from API), err.message will be undefined, causing the error state to be set to undefined.",\n      "impact": "Error state may become undefined instead of a string, breaking UI expectations and losing error information.",\n      "suggested_fix": "Check if error is an Error instance before accessing message, otherwise convert to string.",\n      "code_before": "    } catch (err: any) {\\n      setError(err.message);\\n    }",\n      "code_after": "    } catch (err) {\\n      const message = err instanceof Error ? err.message : String(err);\\n      setError(message);\\n    }",\n      "references": []\n    }\n  ],\n  "positive_observations": [\n    "Strong TypeScript typing for all state and props",\n    "Proper use of useCallback to prevent unnecessary re-renders of returned functions",\n    "Loading state correctly set to true at start of async operations",\n    "Error state properly reset before each async operation",\n    "useEffect correctly refetches todos when filter changes"\n  ]\n}\n<<<ENDARTIFACT>>>\n```'}