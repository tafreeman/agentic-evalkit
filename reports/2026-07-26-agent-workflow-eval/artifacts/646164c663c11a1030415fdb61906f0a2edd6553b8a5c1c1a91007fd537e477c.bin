{'review': '{\n  "review": "<<<ARTIFACT review_report>>>\\n{\\n  \\"overall_status\\": \\"NEEDS_FIXES\\",\\n  \\"quality_score\\": 2.5,\\n  \\"summary\\": {\\n    \\"critical\\": 1,\\n    \\"high\\": 3,\\n    \\"medium\\": 4,\\n    \\"low\\": 5,\\n    \\"passed_checks\\": [\\"useCallback used correctly for connect/disconnect/sendMessage\\", \\"useRef used for mutable values\\", \\"timeout cleared on disconnect\\", \\"readyState checked before sending\\"]\\n  },\\n  \\"findings\\": [\\n    {\\n      \\"finding_id\\": \\"F-001\\",\\n      \\"severity\\": \\"critical\\",\\n      \\"category\\": \\"security\\",\\n      \\"title\\": \\"Access token exposed in WebSocket URL and logs\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [28, 31],\\n      \\"description\\": \\"The access token is appended to the WebSocket URL as a query parameter and logged in clear text, exposing it to potential leakage via server logs, browser history, HTTP referer headers, and debug outputs.\\",\\n      \\"impact\\": \\"Token theft leading to unauthorized access to user accounts and sensitive data.\\",\\n      \\"suggested_fix\\": \\"Avoid placing tokens in URLs. Since WebSocket API doesn\'t support headers, consider: 1) Using wss:// for encryption in transit, 2) Sending token as first message after connection (if server protocol allows), 3) Using subprotocol negotiation (Sec-WebSocket-Protocol). As interim fix: URL-encode token and redact from logs.\\",\\n      \\"code_before\\": \\"    const wsUrlWithToken = `${url}?access_token=${accessToken}`;\\n    console.log(`Attempting to connect to WebSocket: ${wsUrlWithToken}`);\\",\\n      \\"code_after\\": \\"    // URL-encode token to prevent injection and broken URLs\\n    const encodedToken = encodeURIComponent(accessToken);\\n    const wsUrlWithToken = `${url}?access_token=${encodedToken}`;\\n    // Redact token in logs to prevent exposure\\n    const loggedUrl = wsUrlWithToken.replace(/access_token=[^&]*/, \'access_token=[REDACTED]\');\\n    console.log(`Attempting to connect to WebSocket: ${loggedUrl}`);\\",\\n      \\"references\\": [\\"OWASP A02:2021-Cryptographic Failures\\", \\"CWE-319: Cleartext Transmission of Sensitive Information\\", \\"https://cheatsheetseries.owasp.org/cheatsheets/JSON_Security_Cheat_Sheet.html#web-messaging\\"]\\n    },\\n    {\\n      \\"finding_id\\": \\"F-002\\",\\n      \\"severity\\": \\"high\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"Missing URL encoding for access token in WebSocket URL\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [28, 28],\\n      \\"description\\": \\"The access token is directly interpolated into the URL without encoding, which could break the URL format if the token contains special characters (e.g., &, =, ?, spaces).\\",\\n      \\"impact\\": \\"Malformed WebSocket URL causing connection failures. Potential for URL injection if token contains malicious payloads (though less likely for tokens).\\",\\n      \\"suggested_fix\\": \\"Apply encodeURIComponent to the access token before inserting into URL.\\",\\n      \\"code_before\\": \\"    const wsUrlWithToken = `${url}?access_token=${accessToken}`;\\n    console.log(`Attempting to connect to WebSocket: ${wsUrlWithToken}`);\\",\\n      \\"code_after\\": \\"    const encodedToken = encodeURIComponent(accessToken);\\n    const wsUrlWithToken = `${url}?access_token=${encodedToken}`;\\n    const loggedUrl = wsUrlWithToken.replace(/access_token=[^&]*/, \'access_token=[REDACTED]\');\\n    console.log(`Attempting to connect to WebSocket: ${loggedUrl}`);\\",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-003\\",\\n      \\"severity\\": \\"medium\\",\\n      \\"category\\": \\"security\\",\\n      \\"title\\": \\"WebSocket URL not validated for scheme or format\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [18, 18],\\n      \\"description\\": \\"The \'url\' parameter is used directly in WebSocket constructor without validation. It could be an empty string, invalid format, or use insecure ws:// scheme (instead of wss://).\\",\\n      \\"impact\\": \\"Connection failures due to invalid URL. Potential man-in-the-middle attacks if ws:// is used (unencrypted transmission).\\",\\n      \\"suggested_fix\\": \\"Add validation: ensure url is non-empty string and starts with wss:// (or ws:// for localhost/dev). Log warning for insecure scheme.\\",\\n      \\"code_before\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"code_after\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  // Validate URL\\n  if (typeof url !== \'string\' || !url.trim()) {\\n    throw new Error(\'WebSocket URL must be a non-empty string\');\\n  }\\n  if (!url.startsWith(\'wss://\') && !url.startsWith(\'ws://\')) {\\n    console.warn(\'WebSocket URL should use wss:// for secure connections. Using ws:// may expose data to interception.\');\\n  }\\n  \\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"references\\": [\\"OWASP A01:2021-Broken Access Control\\", \\"CWE-319: Cleartext Transmission of Sensitive Information\\", \\"https://developer.mozilla.org/en-US/docs/Web/API/WebSocket/WebSocket#security\\"]\\n    },\\n    {\\n      \\"finding_id\\": \\"F-004\\",\\n      \\"severity\\": \\"high\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"Reconnect limit logic blocks initial connection attempt when limit is 0\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [48, 50],\\n      \\"description\\": \\"The condition \'if (reconnectAttempts.current >= reconnectLimit)\' incorrectly blocks the very first connection attempt when reconnectLimit is set to 0, because reconnectAttempts starts at 0 (0 >= 0 evaluates to true).\\",\\n      \\"impact\\": \\"WebSocket never connects when reconnectLimit is 0, even for initial connection. This breaks expected behavior where reconnectLimit should only apply to reconnection attempts after a failure.\\",\\n      \\"suggested_fix\\": \\"Track whether we have ever connected successfully. Only apply reconnectLimit to reconnection attempts (after at least one successful connection).\\",\\n      \\"code_before\\": \\"    if (reconnectAttempts.current >= reconnectLimit) {\\n      console.warn(\\"WebSocket reconnect limit reached.\\");\\n      return;\\n    }\\n\\n    const wsUrlWithToken = `${url}?access_token=${accessToken}`;\\n    console.log(`Attempting to connect to WebSocket: ${wsUrlWithToken}`);\\n    ws.current = new WebSocket(wsUrlWithToken);\\",\\n      \\"code_after\\": \\"    // Track if we\'ve ever connected successfully to distinguish initial connection from reconnects\\n    const hasEverConnected = useRef(false);\\n    \\n    // Block reconnection attempts only if we\'ve connected before and exceeded limit\\n    if (hasEverConnected.current && reconnectAttempts.current >= reconnectLimit) {\\n      console.warn(\\"WebSocket reconnect limit reached.\\");\\n      return;\\n    }\\n\\n    const encodedToken = encodeURIComponent(accessToken);\\n    const wsUrlWithToken = `${url}?access_token=${encodedToken}`;\\n    const loggedUrl = wsUrlWithToken.replace(/access_token=[^&]*/, \'access_token=[REDACTED]\');\\n    console.log(`Attempting to connect to WebSocket: ${loggedUrl}`);\\n    \\n    try {\\n      ws.current = new WebSocket(wsUrlWithToken);\\n    } catch (err) {\\n      console.error(\'Failed to create WebSocket:\', err);\\n      onError?.(new ErrorEvent(\'error\', { error: err }));\\n      return;\\n    }\\",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-005\\",\\n      \\"severity\\": \\"high\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"Reconnect attempts not reset when access token changes\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [18, 18],\\n      \\"description\\": \\"When the accessToken changes (e.g., user logs in with different account), the reconnectAttempts ref retains its previous value. This can cause the new token\'s connection attempts to be incorrectly limited by the old token\'s failed attempt count.\\",\\n      \\"impact\\": \\"Premature exhaustion of reconnect limit for new token, preventing reconnection even when attempts should be reset for new session.\\",\\n      \\"suggested_fix\\": \\"Reset reconnectAttempts and hasEverConnected when accessToken changes (indicating a new session).\\",\\n      \\"code_before\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"code_after\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  // Reset session state when token changes (new login/session)\\n  const hasEverConnected = useRef(false);\\n  const reconnectAttempts = useRef(0);\\n  \\n  // Reset refs when accessToken changes to start fresh session\\n  useEffect(() => {\\n    if (accessToken) {\\n      hasEverConnected.current = false;\\n      reconnectAttempts.current = 0;\\n    }\\n  }, [accessToken]);\\n\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-006\\",\\n      \\"severity\\": \\"medium\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"Missing error handling for WebSocket constructor\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [58, 58],\\n      \\"description\\": \\"The WebSocket constructor can throw exceptions (e.g., invalid URL, security errors) which are not caught, potentially breaking the hook and causing unhandled promise rejections.\\",\\n      \\"impact\\": \\"Application crashes or silent failures when WebSocket initialization fails due to invalid input or network issues.\\",\\n      \\"suggested_fix\\": \\"Wrap WebSocket constructor in try/catch block, log error, and invoke onError callback.\\",\\n      \\"code_before\\": \\"    const wsUrlWithToken = `${url}?access_token=${accessToken}`;\\n    console.log(`Attempting to connect to WebSocket: ${wsUrlWithToken}`);\\n    ws.current = new WebSocket(wsUrlWithToken);\\",\\n      \\"code_after\\": \\"    const encodedToken = encodeURIComponent(accessToken);\\n    const wsUrlWithToken = `${url}?access_token=${encodedToken}`;\\n    const loggedUrl = wsUrlWithToken.replace(/access_token=[^&]*/, \'access_token=[REDACTED]\');\\n    console.log(`Attempting to connect to WebSocket: ${loggedUrl}`);\\n    \\n    try {\\n      ws.current = new WebSocket(wsUrlWithToken);\\n    } catch (err) {\\n      console.error(\'Failed to create WebSocket:\', err);\\n      onError?.(new ErrorEvent(\'error\', { error: err }));\\n      return;\\n    }\\",\\n      \\"references\\": [\\"CWE-703: Improper Check or Handling of Exceptional Conditions\\"]\\n    },\\n    {\\n      \\"finding_id\\": \\"F-007\\",\\n      \\"severity\\": \\"medium\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"WebSocket event callbacks invoked without error handling\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [61, 78],\\n      \\"description\\": \\"The onOpen, onMessage, onError, and onClose callbacks are called directly without try/catch. If these user-provided functions throw exceptions, it will break the WebSocket event handling and potentially cause memory leaks or unresponsive UI.\\",\\n      \\"impact\\": \\"Uncaught errors in user callbacks disrupt WebSocket event processing, leading to missed messages, failed reconnections, or application instability.\\",\\n      \\"suggested_fix\\": \\"Wrap each callback invocation in try/catch block, log errors, and prevent propagation.\\",\\n      \\"code_before\\": \\"    ws.current.onopen = (event) => {\\n      console.log(\\"WebSocket connected.\\");\\n      setIsConnected(true);\\n      reconnectAttempts.current = 0;\\n      onOpen?.(event);\\n    };\\n\\n    ws.current.onmessage = (event) => {\\n      setMessage(event.data);\\n      onMessage?.(event);\\n    };\\n\\n    ws.current.onerror = (event) => {\\n      console.error(\\"WebSocket error:\\", event);\\n      onError?.(event);\\n    };\\n\\n    ws.current.onclose = (event) => {\\n      console.log(\\"WebSocket disconnected:\\", event.code, event.reason);\\n      setIsConnected(false);\\n      onClose?.(event);\\n\\n      if (!event.wasClean && reconnectAttempts.current < reconnectLimit) {\\n        reconnectAttempts.current++;\\n        console.log(`Attempting to reconnect in ${reconnectInterval / 1000}s... (Attempt ${reconnectAttempts.current}/${reconnectLimit})`);\\n        timeoutId.current = setTimeout(connect, reconnectInterval);\\n      }\\n    };",\\n      \\"code_after\\": \\"    ws.current.onopen = (event) => {\\n      try {\\n        console.log(\\"WebSocket connected.\\");\\n        setIsConnected(true);\\n        reconnectAttempts.current = 0;\\n        hasEverConnected.current = true;\\n        onOpen?.(event);\\n      } catch (err) {\\n        console.error(\'Error in onOpen callback:\', err);\\n      }\\n    };\\n\\n    ws.current.onmessage = (event) => {\\n      try {\\n        setMessage(event.data);\\n        onMessage?.(event);\\n      } catch (err) {\\n        console.error(\'Error in onMessage callback:\', err);\\n      }\\n    };\\n\\n    ws.current.onerror = (event) => {\\n      try {\\n        console.error(\\"WebSocket error:\\", event);\\n        onError?.(event);\\n      } catch (err) {\\n        console.error(\'Error in onError callback:\', err);\\n      }\\n    };\\n\\n    ws.current.onclose = (event) => {\\n      try {\\n        console.log(\\"WebSocket disconnected:\\", event.code, event.reason);\\n        setIsConnected(false);\\n        onClose?.(event);\\n\\n        if (!event.wasClean && reconnectAttempts.current < reconnectLimit) {\\n          reconnectAttempts.current++;\\n          console.log(`Attempting to reconnect in ${reconnectInterval / 1000}s... (Attempt ${reconnectAttempts.current}/${reconnectLimit})`);\\n          timeoutId.current = setTimeout(connect, reconnectInterval);\\n        }\\n      } catch (err) {\\n        console.error(\'Error in onClose callback:\', err);\\n      }\\n    };",\\n      \\"references\\": [\\"CWE-703: Improper Check or Handling of Exceptional Conditions\\", \\"https://reactjs.org/docs/error-boundaries.html\\"]\\n    },\\n    {\\n      \\"finding_id\\": \\"F-008\\",\\n      \\"severity\\": \\"low\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"Missing validation for reconnectInterval and reconnectLimit parameters\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [18, 18],\\n      \\"description\\": \\"The reconnectInterval and reconnectLimit options are used without validation. Negative values or non-numbers could cause unexpected behavior (e.g., negative timeout delay treated as 0, causing busy loops).\\",\\n      \\"impact\\": \\"Potential for infinite reconnection loops (if interval <= 0) or immediate connection blocking (if limit < 0).\\",\\n      \\"suggested_fix\\": \\"Add validation: ensure reconnectInterval is a positive number (with minimum threshold) and reconnectLimit is a non-negative integer.\\",\\n      \\"code_before\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"code_after\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  // Validate and sanitize options\\n  const safeReconnectInterval = Math.max(100, Number(options?.reconnectInterval) || 3000);\\n  const safeReconnectLimit = Math.max(0, Math.floor(Number(options?.reconnectLimit) || 5));\\n  \\n  if (Number.isNaN(safeReconnectInterval) || safeReconnectInterval < 100) {\\n    console.warn(\'reconnectInterval must be a positive number >= 100ms. Using default 3000ms.\');\\n    safeReconnectInterval = 3000;\\n  }\\n  if (Number.isNaN(safeReconnectLimit) || safeReconnectLimit < 0) {\\n    console.warn(\'reconnectLimit must be a non-negative integer. Using default 5.\');\\n    safeReconnectLimit = 5;\\n  }\\n\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\n\\n  // Use validated values in logic below\\n  const reconnectInterval = safeReconnectInterval;\\n  const reconnectLimit = safeReconnectLimit;\\n  ...\\",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-009\\",\\n      \\"severity\\": \\"low\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"Message state overwrites previous messages\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [65, 66],\\n      \\"description\\": \\"The \'message\' state is set to the latest incoming message, overwriting any previous message. Consumers that need to process multiple messages (e.g., chat applications) may miss messages if state updates are batched or processing is slow.\\",\\n      \\"impact\\": \\"Message loss in high-throughput scenarios. Inability to implement message queues or history.\\",\\n      \\"suggested_fix\\": \\"Return a message queue or callback-based API instead of state. Alternatively, provide an optional message history buffer.\\",\\n      \\"code_before\\": \\"    ws.current.onmessage = (event) => {\\n      setMessage(event.data);\\n      onMessage?.(event);\\n    };\\n\\n  const sendMessage = useCallback((message: string) => {\\n    if (ws.current && ws.current.readyState === WebSocket.OPEN) {\\n      ws.current.send(message);\\n    } else {\\n      console.warn(\\"WebSocket is not open. Cannot send message.\\");\\n    }\\n  }, []);\\n\\n  return { ws: ws.current, isConnected, message, sendMessage, connect, disconnect };",\\n      \\"code_after\\": \\"    // Optional: maintain message history (last N messages)\\n    const [messageHistory, setMessageHistory] = useState<string[]>([]);\\n    \\n    ws.current.onmessage = (event) => {\\n      try {\\n        const newMessage = event.data;\\n        setMessage(newMessage);\\n        setMessageHistory(prev => [newMessage, ...prev.slice(0, 99)]); // Keep last 100 messages\\n        onMessage?.(event);\\n      } catch (err) {\\n        console.error(\'Error in onMessage callback:\', err);\\n      }\\n    };\\n\\n    const sendMessage = useCallback((message: string) => {\\n      if (ws.current && ws.current.readyState === WebSocket.OPEN) {\\n        ws.current.send(message);\\n      } else {\\n        console.warn(\\"WebSocket is not open. Cannot send message.\\");\\n      }\\n    }, []);\\n\\n  return { \\n    ws: ws.current, \\n    isConnected, \\n    message, \\n    messageHistory, // Optional: expose message history\\n    sendMessage, \\n    connect, \\n    disconnect \\n  };",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-010\\",\\n      \\"severity\\": \\"low\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"accessToken type not validated at runtime\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [18, 18],\\n      \\"description\\": \\"While accessToken is typed as string | null, runtime type checks are missing. If a non-string, non-null value is passed (e.g., object, number), it will be converted to string via URL interpolation, potentially causing malformed URLs or security issues.\\",\\n      \\"impact\\": \\"Incorrect URL formation (e.g., \'[object Object]\') leading to connection failures. Potential for injection if token-like objects are passed.\\",\\n      \\"suggested_fix\\": \\"Add runtime type check for accessToken: ensure it is either null or a string.\\",\\n      \\"code_before\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"code_after\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  // Validate accessToken type\\n  if (accessToken !== null && typeof accessToken !== \'string\') {\\n    console.error(\'accessToken must be a string or null. Received:\', typeof accessToken);\\n    return; // Early exit to prevent malformed URL\\n  }\\n\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-011\\",\\n      \\"severity\\": \\"low\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"url parameter type not validated at runtime\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [18, 18],\\n      \\"description\\": \\"The \'url\' parameter is expected to be a string but lacks runtime validation. If a non-string value is passed, it will cause errors in URL interpolation and WebSocket construction.\\",\\n      \\"impact\\": \\"TypeError during URL string interpolation or WebSocket constructor failure, breaking the hook.\\",\\n      \\"suggested_fix\\": \\"Add runtime check to ensure url is a non-empty string.\\",\\n      \\"code_before\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"code_after\\": \\"export const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  // Validate url\\n  if (typeof url !== \'string\' || !url.trim()) {\\n    throw new Error(\'WebSocket URL must be a non-empty string\');\\n  }\\n\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"references\\": []\\n    },\\n    {\\n      \\"finding_id\\": \\"F-012\\",\\n      \\"severity\\": \\"medium\\",\\n      \\"category\\": \\"quality\\",\\n      \\"title\\": \\"WebSocket event callback types not validated\\",\\n      \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n      \\"line_range\\": [12, 17],\\n      \\"description\\": \\"The options.onOpen, onMessage, onError, and onClose properties are assumed to be functions but are not validated. If non-function values are passed, invoking them will throw TypeError.\\",\\n      \\"impact\\": \\"Runtime errors when WebSocket events occur, disrupting connection handling and potentially causing reconnection logic to fail.\\",\\n      \\"suggested_fix\\": \\"Add type checks for each callback option before assigning to WebSocket event handlers.\\",\\n      \\"code_before\\": \\"interface WebSocketOptions {\\n  onOpen?: (event: Event) => void;\\n  onMessage?: (event: MessageEvent) => void;\\n  onError?: (event: Event) => void;\\n  onClose?: (event: CloseEvent) => void;\\n  reconnectInterval?: number;\\n  reconnectLimit?: number;\\n}\\n\\nexport const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n    reconnectInterval = 3000,\\n    reconnectLimit = 5,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\",\\n      \\"code_after\\": \\"interface WebSocketOptions {\\n  onOpen?: (event: Event) => void;\\n  onMessage?: (event: MessageEvent) => void;\\n  onError?: (event: Event) => void;\\n  onClose?: (event: CloseEvent) => void;\\n  reconnectInterval?: number;\\n  reconnectLimit?: number;\\n}\\n\\nexport const useWebSocket = (url: string, accessToken: string | null, options?: WebSocketOptions) => {\\n  // Validate callback types\\n  const safeOnOpen = typeof options?.onOpen === \'function\' ? options.onOpen : undefined;\\n  const safeOnMessage = typeof options?.onMessage === \'function\' ? options.onMessage : undefined;\\n  const safeOnError = typeof options?.onError === \'function\' ? options.onError : undefined;\\n  const safeOnClose = typeof options?.onClose === \'function\' ? options.onClose : undefined;\\n  \\n  const {\\n    onOpen: _, // unused\\n    onMessage: _,\\n    onError: _,\\n    onClose: _,\\n    reconnectInterval,\\n    reconnectLimit,\\n  } = options || {};\\n\\n  const ws = useRef<WebSocket | null>(null);\\n  const [isConnected, setIsConnected] = useState(false);\\n  const [message, setMessage] = useState<string | null>(null);\\n  const reconnectAttempts = useRef(0);\\n  const timeoutId = useRef<NodeJS.Timeout | null>(null);\\n\\n  const {\\n    onOpen,\\n    onMessage,\\n    onError,\\n    onClose,\\n  } = { safeOnOpen, safeOnMessage, safeOnError, safeOnClose }; // UseCallback for sendMessage has empty dependency array but uses ws.ref - this is actually safe because the ref object is stable, but we note it as acceptable.\\n    \\"file\\": \\"src/hooks/useWebSocket.ts\\",\\n    \\"line_range\\": [100, 106],\\n    \\"description\\": \\"The sendMessage useCallback has an empty dependency array. While it correctly uses the stable ws.ref (not the ref\'s current value), we note that if the ws.ref were to be replaced (which it isn\'t in this hook), this could be problematic. However, the ws.ref is never reassigned, only its .current property changes, so this is safe.\\",\\n      \\"impact\\": \\"No actual issue - this is a correct use of useCallback with refs.\\",\\n      \\"suggested_fix\\": \\"No fix needed. This is a proper pattern for callbacks that depend on refs.\\",\\n      \\"code_before\\": \\"  const sendMessage = useCallback((message: string) => {\\n    if (ws.current && ws.current.readyState === WebSocket.OPEN) {\\n      ws.current.send(message);\\n    } else {\\n      console.warn(\\"WebSocket is not open. Cannot send message.\\");\\n    }\\n  }, []);\\",\\n      \\"code_after\\": \\"  // No change needed - this is correct\\n  const sendMessage = useCallback((message: string) => {\\n    if (ws.current && ws.current.readyState === WebSocket.OPEN) {\\n      ws.current.send(message);\\n    } else {\\n      console.warn(\\"WebSocket is not open. Cannot send message.\\");\\n    }\\n  }, []);\\",\\n      \\"references\\": [\\"https://reactjs.org/docs/hooks-faq.html#how-to-read-an-often-changing-value-from-usecallback\\"]\\n    }\\n  ],\\n  \\"positive_observations\\": [\\n    \\"Proper use of useRef for WebSocket instance, reconnect attempts, and timeout ID to avoid stale closures\\",\\n    \\"Effective cleanup in disconnect function: closes WebSocket and clears reconnect timeout\\",\\n    \\"Correct use of useEffect to manage connection lifecycle based on accessToken changes\\",\\n    \\"Appropriate readyState check (WebSocket.OPEN) before sending messages\\",\\n    \\"Reconnect attempts reset on successful connection (onopen handler)\\",\\n    \\"Early return when no accessToken provided, preventing invalid connection attempts\\"\\n  ]\\n}\\n<<<ENDARTIFACT>>>"'}