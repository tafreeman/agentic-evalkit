s.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)\\n    .AddJwtBearer(options =>\\n    {\\n        options.Authority = builder.Configuration[\\"Jwt:Authority\\"];\\n        options.Audience = builder.Configuration[\\"Jwt:Audience\\"];\\n        options.RequireHttpsMetadata = builder.Environment.IsProduction();\\n        options.TokenValidationParameters = new TokenValidationParameters\\n        {\\n            ValidateIssuer = true,\\n            ValidateAudience = true,\\n            ValidateLifetime = true,\\n            ValidateIssuerSigningKey = true,\\n            ValidIssuer = builder.Configuration[\\"Jwt:Issuer\\"],\\n            ValidAudience = builder.Configuration[\\"Jwt:Audience\\"],\\n            IssuerSigningKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(builder.Configuration[\\"Jwt:Key\\"]))\\n        };    \\n    });"\n    },\n    {\n      "finding_id": "F-002",\n      "severity": "medium",\n      "category": "quality",\n      "title": "Missing global exception handling and logging",\n      "file": "src/Api/Program.cs",\n      "line_range": [1, 1],\n      "description": "The application lacks centralized exception handling and structured logging. Unhandled exceptions will return raw 500 errors without logging, making debugging difficult in production.",\n      "impact": "Production issues may go undetected, and users receive unhelpful error messages. No audit trail for security events or operational metrics.",\n      "suggested_fix": "Add logging configuration and a global exception handler. Example: builder.Logging.AddConsole(); builder.Logging.AddDebug(); app.UseExceptionHandler(\'/error\'); app.Map(\'/error\', (HttpContext context) => { var exception = context.Features.Get<IExceptionHandlerFeature>()?.Error; var logger = context.RequestServices.GetRequiredService<ILogger<Program>>(); logger.LogError(exception, \'Unhandled exception\'); return Results.Problem(); });",\n      "code_before": "",\n      "code_after": "var builder = WebApplication.CreateBuilder(args);\\nbuilder.Logging.AddConsole();\\nbuilder.Logging.AddDebug();\\n\\n// ... existing code ...\\n\\nvar app = builder.Build();\\n\\n// ... existing code ...\\n\\napp.UseExceptionHandler(\'/error\');\\napp.Map(\'/error\', (HttpContext context) => {\\n    var exception = context.Features.Get<IExceptionHandlerFeature>()?.Error;\\n    var logger = context.RequestServices.GetRequiredService<ILogger<Program>>();\\n    logger.LogError(exception, \'Unhandled exception\');\\n    return Results.Problem();\\n});\\n\\n// ... existing code ..."\n    },\n    {\n      "finding_id": "F-003",\n      "severity": "medium",\n      "category": "performance",\n      "title": "GetAllTodos endpoint lacks pagination",\n      "file": "src/Api/Program.cs",\n      "line_range": [30, 38],\n      "description": "The GetAllTodos endpoint returns all todo items without pagination, which could cause performance degradation and high memory usage as the dataset grows.",\n      "impact": "Large todo lists will cause slow response times, high bandwidth consumption, and potential timeouts. Not scalable for production use.",\n      "suggested_fix": "Add query parameters for page size and page number, and modify the service method to support pagination. Example: app.MapGet(\\"/v1/todos\\", [Authorize] async (TodoService todoService, [FromQuery] int pageSize = 10, [FromQuery] int pageIndex = 0) => { var todos = await todoService.GetAllTodosAsync(pageSize, pageIndex); return Results.Ok(todos.Select(t => t.ToTodoResponse())); });",\n      "code_before": "app.MapGet(\\"/v1/todos\\", [Authorize] async (TodoService todoService) =>\\n{\\n    var todos = await todoService.GetAllTodosAsync();\\n    return Results.Ok(todos.Select(t => t.ToTodoResponse()));\\n})",\n      "code_after": "app.MapGet(\\"/v1/todos\\", [Authorize] async (TodoService todoService, [FromQuery] int pageSize = 10, [FromQuery] int pageIndex = 0) =>\\n{\\n    var todos = await todoService.GetAllTodosAsync(pageSize, pageIndex);\\n    return Results.Ok(todos.Select(t => t.ToTodoResponse()));\\n})"\n    },\n    {\n      "finding_id": "F-004",\n      "severity": "low",\n      "category": "quality",\n      "title": "Missing input validation for route parameters",\n      "file": "src/Api/Program.cs",\n      "line_range": [46, 54],\n      "description": "The {id} route parameter in PUT and DELETE endpoints is accepted as Guid but lacks validation for empty or invalid GUIDs. While ASP.NET Core will return 400 for malformed GUIDs, explicit validation improves clarity.",\n      "impact": "Minor - framework already handles invalid GUID format, but missing validation for Guid.Empty could lead to unintended behavior (e.g., attempting to delete/update todo with ID 00000000-0000-0000-0000-000000000000).",\n      "suggested_fix": "Add explicit validation for Guid.Empty in the endpoint handlers. Example: if (id == Guid.Empty) return Results.BadRequest(new { message = \\"Invalid todo ID\\" });",\n      "code_before": "app.MapPut(\\"/v1/todos/{id}/complete\\", [Authorize] async (Guid id, TodoService todoService) =>\\n{\\n    var result = await todoService.MarkTodoAsCompleteAsync(id);\\n    // ...\\n});",\n      "code_after": "app.MapPut(\\"/v1/todos/{id}/complete\\", [Authorize] async (Guid id, TodoService todoService) =>\\n{\\n    if (id == Guid.Empty)\\n        return Results.BadRequest(new { message = \\"Invalid todo ID\\" });\\n    var result = await todoService.MarkTodoAsCompleteAsync(id);\\n    // ...\\n});"\n    },\n    {\n      "finding_id": "F-005",\n      "severity": "low",\n      "category": "quality",\n      "title": "Missing API versioning in endpoint names",\n      "file": "src/Api/Program.cs",\n      "line_range": [30, 70],\n      "description": "While endpoints are versioned in the path (/v1/todos), the endpoint names (e.g., \\"GetAllTodos\\") do not include the version, which could cause confusion when multiple versions exist.",\n      "impact": "Low - primarily a maintainability issue. Could lead to incorrect URL generation or confusion in API documentation.",\n      "suggested_fix": "Include version in endpoint names for clarity. Example: .WithName(\\"GetAllTodosV1\\")",\n      "code_before": "app.MapGet(\\"/v1/todos\\", [Authorize] async (TodoService todoService) =>\\n{\\n    // ...\\n})\\n.WithName(\\"GetAllTodos\\")",\n      "code_after": "app.MapGet(\\"/v1/todos\\", [Authorize] async (TodoService todoService) =>\\n{\\n    // ...\\n})\\n.WithName(\\"GetAllTodosV1\\")"\n    }\n  ],\n  "positive_observations": [\n    "Authentication and authorization properly configured and applied to all endpoints",\n    "DTO mapping centralized via extension methods (ToTodoResponse)",\n    "Error handling in service layer uses discriminated unions (Result pattern)",\n    "Swagger enabled only in development",\n    "Connection string properly validated with exception on missing value",\n    "HTTPS redirection enabled",\n    "No hardcoded secrets or sensitive data in code"\n  ]\n}\n<<<ENDARTIFACT>>>\n```'}