{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "tool-call-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One tool call from an agent run (``schemas/tool-call-record.v1.schema.json``).\n\n``arguments`` and ``result`` are kept verbatim because the detectors need\nthe command lines and fetched URLs; redaction happens when evidence is\nbuilt (:func:`agentic_evalkit.integrity.flags.make_flag`).",
  "properties": {
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Arguments",
      "type": "object"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "gate_decision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gate Decision"
    },
    "result": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "sample_id",
    "call_id",
    "tool"
  ],
  "title": "ToolCallRecord",
  "type": "object"
}
